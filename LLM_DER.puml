```plantuml
@startuml
hide circle

entity Clientes {
  * id_cliente : int <<PK>>
  --
  nome : varchar
  telefone : varchar <<multivalorado>>
  endereço : varchar
}

entity Pedido {
  * id_pedido : int <<PK>>
  --
  data_do_pedido : date
  id_cliente : int <<FK>>
}

entity "Itens do Pedido" as ItemPedido {
  * numero_item : int <<PK>>
  --
  quantidade : int
}

entity Produto {
  * id_produto : int <<PK>>
  --
  descricao : varchar
}

Clientes ||--o{ Pedido : faz
ItemPedido ||--|{ Pedido : contém
Produto ||--o{ ItemPedido : compõe
@enduml
```
